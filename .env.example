# Скопируйте этот файл в .env.local (разработка) или .env.production (сборка) и задайте значения.
# Все переменные, доступные в браузере, должны начинаться с VITE_

# Куда уходят заявки с формы: воркер бота из папки bot/, путь /lead.
VITE_LEAD_ENDPOINT=https://orion-bot.REPLACE_ME.workers.dev/lead

# Адрес сайта: canonical, sitemap.xml и превью ссылок (см. vite.config.ts).
VITE_SITE_URL=https://orion.example
