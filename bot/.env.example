# Настройки бота для запуска на своём сервере (node src/server.ts).
# На сервере этот файл лежит в /etc/orion-bot.env с правами 600 — см. DEPLOY.md.
# Секреты сюда вписываете только вы, в git этот файл не попадает.

# Токен от @BotFather.
BOT_TOKEN=

# Ваш chat_id: бот пришлёт его в ответ на /start, пока значение пустое.
ADMIN_CHAT_ID=

# Общий секрет с Google Apps Script. Сгенерировать: openssl rand -hex 32
MAIL_SECRET=

# Адрес веб-приложения Apps Script — кнопки «Прочитано» и «В архив» в Gmail. Необязательно.
GMAIL_ACTION_URL=

# Домен сайта: заявки принимаются только с него. Через запятую, с https://.
ALLOWED_ORIGINS=https://example.ru,https://www.example.ru
SITE_URL=https://example.ru
CONTACT_URL=https://t.me/sp1retdev
TIMEZONE=Europe/Moscow

# Где слушать HTTP (снаружи его открывает nginx по адресу /api/).
PORT=8787
HOST=127.0.0.1

# Файл с заявками и настройками.
DATA_FILE=/var/lib/orion-bot/kv.json
